[package]
name = "hello-effect-host"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
blake3 = "1"
echo-edict-canonical = { path = "@ECHO_REPO@/crates/echo-edict-canonical" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
warp-core = { path = "@ECHO_REPO@/crates/warp-core" }

[[bin]]
name = "hello-effect-host"
path = "@PROJECT_ROOT@/effect-host/src/main.rs"
